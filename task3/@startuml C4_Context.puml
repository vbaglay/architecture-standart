@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml


Person_Ext(client, "Клиент", "Пользователь сайта или интернет-банка")
System_Boundary(bn, "Банк «Стандарт»") {
  System(site, "Сайт", "PHP + React", "Маркетинговая информация + форма заявки")
  System(ib, "Интернет-банк", "ASP.NET MVC", "Подача заявки, личный кабинет")
  System(ris, "Request Intake Service", "ASP.NET Web API", "Промежуточный сервис приёма заявок")
  System(ctr, "Система кол-центра", "Java Spring Boot", "Обработка заявок менеджерами")
  System(abs, "АБС", "Delphi + Oracle", "Характер бухгалтерии и учёта ставок")
  System(sms, "SMS-сервис", "Внешний телеком-оператор", "Отправка SMS-уведомлений")
}

Rel(client, site, "Подать заявку")
Rel(client, ib, "Подать/просмотреть заявку")
Rel(site, ris, "POST /api/requests")
Rel(ib, ris, "POST /api/requests")
Rel(ris, ctr, "Отправка заявки", "REST/JSON")
Rel(ris, abs, "Передача заявки на согласование", "JDBC/REST")
Rel(abs, sms, "Запрос отправки SMS", "REST")
Rel(sms, client, "Отправка SMS")
@enduml
