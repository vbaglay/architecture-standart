#### **Диаграмма контекста (C4 Level 1)**  
```plantuml
@startuml ContextDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person_Ext(клиент_сайт, "Клиент (сайт)", "Подаёт заявку через сайт")
Person_Ext(клиент_иб, "Клиент (интернет-банк)", "Открывает депозит онлайн")
System(сайт, "Сайт", "PHP + React.js", "Подача заявок новыми клиентами")
System(интернет_банк, "Интернет-банк", "ASP.NET + MS SQL", "Онлайн-открытие депозитов")
System(кол_центр, "Кол-центр", "Java Spring Boot + PostgreSQL", "Обработка заявок")
System(абс, "АБС", "Oracle + PL/SQL", "Хранение ставок и заявок")
System_Ext(телеком, "Телеком-оператор", "Отправка SMS")

Rel(клиент_сайт, сайт, "Подаёт заявку (ФИО, телефон)")
Rel(клиент_иб, интернет_банк, "Выбирает счёт, сумму, подтверждает SMS")
Rel(сайт, кол_центр, "Передаёт заявку")
Rel(кол_центр, абс, "Синхронизация данных через промежуточный слой")
Rel(интернет_банк, абс, "Асинхронная интеграция через очереди")
Rel(абс, телеком, "Отправка SMS-уведомлений")

@enduml

@startuml ContainerDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person_Ext(клиент_сайт, "Клиент (сайт)", "Подаёт заявку через сайт")
Person_Ext(клиент_иб, "Клиент (интернет-банк)", "Открывает депозит онлайн")

System_Boundary(web, "Веб-системы") {
    Container(сайт, "Сайт", "PHP + React.js", "Форма подачи заявки")
    Container(интернет_банк, "Интернет-банк", "ASP.NET MVC", "Онлайн-депозиты")
    ContainerDb(ms_sql, "База данных", "MS SQL", "Хранение данных интернет-банка")
}

System_Boundary(backend, "Бэкенд") {
    Container(api_gateway, "API Gateway", "C#", "Маршрутизация запросов")
    Container(queue, "Очередь сообщений", "RabbitMQ", "Асинхронная обработка")
    Container(абс_ядро, "АБС (ядро)", "Oracle + PL/SQL", "Обработка заявок и ставок")
    Container(кол_центр_сервис, "Сервис кол-центра", "Java", "Управление заявками")
}

System_Ext(телеком, "Телеком-оператор", "Отправка SMS")

Rel(клиент_сайт, сайт, "HTTPS")
Rel(клиент_иб, интернет_банк, "HTTPS")
Rel(сайт, api_gateway, "Передача заявки (REST)")
Rel(интернет_банк, api_gateway, "Отправка данных (REST)")
Rel(api_gateway, queue, "Асинхронные задачи")
Rel(queue, абс_ядро, "Обработка заявок")
Rel(абс_ядро, телеком, "Интеграция по API")
Rel(кол_центр_сервис, абс_ядро, "Синхронизация данных")
Rel(интернет_банк, ms_sql, "Хранение сессий")

@enduml

@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(client, "Клиент", "Подаёт заявки через сайт или ИБ")
System_Boundary(bank, "Банк «Стандарт»") {
  System(site, "Сайт", "PHP + React.js", "Маркетинговая страница + форма заявки")
  System(ib, "Интернет-банк", "ASP.NET MVC + MS SQL", "Личный кабинет, подача заявки")
  System(ris, "Request Intake Service", "ASP.NET Web API + MS SQL", "Приём и маршрутизация заявок")
  System(ctr, "Система кол-центра", "Java Spring Boot + PostgreSQL", "Обработка заявок менеджерами")
  System(abs, "АБС", "Delphi + Oracle", "Учёт операций и ставок")
  System(sms, "SMS-сервис", "REST API", "Отправка уведомлений клиентам")
}

Rel(client, site, "POST /deposit-request", "HTTPS")
Rel(client, ib, "POST /api/requests", "HTTPS")
Rel(site, ris, "REST API", "JSON/HTTPS")
Rel(ib, ris, "REST API", "JSON/HTTPS")
Rel(ris, ctr, "REST API", "JSON")
Rel(ris, abs, "JDBC/REST", "Передача заявки на согласование")
Rel(abs, sms, "REST API", "Отправка SMS")
Rel(sms, client, "SMS")
@enduml

