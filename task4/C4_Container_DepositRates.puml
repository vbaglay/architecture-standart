@startuml C4_Container_DepositRates
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

System_Boundary(Bank, "Банк «Стандарт»") {
  Container(ABS, "АБС\nOracle + PL/SQL", "Хранит ставки и аудит")

  Container(ExportService, "Сервис экспорта ставок\nC#/.NET", "Генерация, шифрование и выдача ставок") 

  Container(CRM, "CRM кол-центра\nJava + Spring Boot", "UI консультантов") {
    ContainerDb(CRM_DB, "CRM_DB\nPostgreSQL", "Ставки")
  }

  Container_Ext(PartnerCRM, "Кол-центр партнёра", "Импортирует ставки из CSV")
  Container_Ext(SFTP, "SFTP-сервер\nOpenSSH + SSL", "Хранит PGP-CSV-файлы")
  Container_Ext(Monitoring, "Prometheus + Grafana", "Собирает метрики и алерты")
}

Rel(ExportService, ABS, "SQL: читает ставки")
Rel(CRM, ExportService, "HTTPS (OAuth2 + mTLS): запрашивает ставки")
Rel(ExportService, SFTP, "SFTP+SSL: загружает PGP-CSV")
Rel(PartnerCRM, SFTP, "SFTP: скачивает PGP-CSV")
Rel(ExportService, Monitoring, "METRICS: выгрузки, ошибки")
Rel(SFTP, Monitoring, "METRICS: доступность")

@enduml
